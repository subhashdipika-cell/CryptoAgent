# Offline Chronos artifact (must already exist; runtime never downloads it)
CHRONOS_MODEL_PATH=./models/chronos-2-base
TTM_MODEL_PATH=./models/granite-ttm-r3
TIMESFM_MODEL_PATH=./models/timesfm-2.5-200m-transformers
PREDICTIVE_MODE=calibrated
DECISION_POLICY_PATH=./policies/asset_decision_policy.json
PREDICTIVE_VALIDATION_BARS=3000
PREDICTIVE_MIN_FOLDS=30

# Optional cloud sentiment/news credentials
HF_API_KEY=
CRYPTOPANIC_API_KEY=
FOREXLIVE_API_URL=

# MT5 terminal/account
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_BTC_SYMBOL=BTCUSD
MT5_XAU_SYMBOL=XAUUSD
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC=26081301
MT5_APP_NAME=CryptoAgent
TRADING_STRATEGY=ChronosFinBERT
TRADE_JOURNAL_PATH=./data/trade_journal.db
HISTORY_SYNC_DAYS=3650

# Safe defaults. Change both only after DEMO validation.
REQUIRE_DEMO_ACCOUNT=true
TRADING_ENABLED=false
DRY_RUN=true
MAX_RISK_FRACTION=0.01
MAX_MARGIN_FRACTION=0.25
MIN_LEVERAGE=1
MAX_LEVERAGE=500

# Optional local OpenAI-compatible Qwen server for AutoGen code review
QWEN_BASE_URL=http://127.0.0.1:1234/v1
